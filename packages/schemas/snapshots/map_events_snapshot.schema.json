{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    { "$ref": "./_envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "object_type": { "const": "map_events" },
        "data": {
          "type": "object",
          "required": ["events", "filters"],
          "properties": {
            "events": { "type": "array", "items": { "$ref": "./_envelope.schema.json#/$defs/event" } },
            "filters": { "type": "object" }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
