{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stonks-radar.local/schemas/_envelope.schema.json",
  "$defs": {
    "sourcePolicyVersion": {
      "type": "object",
      "required": ["source_key", "policy_version"],
      "properties": {
        "source_key": { "type": "string" },
        "policy_version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "required": ["code", "message", "severity"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "enum": ["info", "warning", "critical"] }
      },
      "additionalProperties": false
    },
    "correction": {
      "type": "object",
      "required": ["id", "title", "status", "published_at", "summary"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "enum": ["correction", "retraction", "clarification"] },
        "published_at": { "type": "string" },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "why_it_matters",
        "occurred_at",
        "published_at",
        "country_region_keys",
        "sector_keys",
        "event_type",
        "severity",
        "confidence",
        "source_strength",
        "freshness",
        "evidence_count",
        "latitude",
        "longitude",
        "affected_objects",
        "source_links",
        "correction_status"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "occurred_at": { "type": "string" },
        "published_at": { "type": "string" },
        "country_region_keys": { "type": "array", "items": { "type": "string" } },
        "sector_keys": { "type": "array", "items": { "type": "string" } },
        "event_type": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_strength": { "type": "string" },
        "freshness": { "enum": ["fresh", "watch", "stale", "unsupported"] },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "affected_objects": { "type": "array", "items": { "type": "string" } },
        "item_kind": { "enum": ["source_discovery", "event_candidate", "reviewed_event", "filing_update", "official_update"] },
        "claim_level": { "enum": ["source_only", "clustered_candidate", "reviewed", "published"] },
        "evidence_match_status": { "enum": ["matched", "weak_match", "mismatch", "unverified"] },
        "review_state": { "enum": ["candidate", "approved", "reviewed", "published"] },
        "source_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url", "source_key", "policy_version"],
            "properties": {
              "label": { "type": "string" },
              "evidence_id": { "type": "string", "pattern": "^(evd|doc|fact)_[A-Za-z0-9_-]{8,80}$" },
              "url": { "type": "string" },
              "source_key": { "type": "string" },
              "policy_version": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "correction_status": { "type": "string" }
      },
      "additionalProperties": false
    },
    "calendarItem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "country_region_key",
        "release_type",
        "scheduled_at",
        "scheduled_local_date",
        "timezone",
        "time_precision",
        "status",
        "expectation_type",
        "expectation_value",
        "actual_value",
        "previous_value",
        "surprise",
        "source",
        "source_url",
        "freshness"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "country_region_key": { "type": "string" },
        "release_type": { "type": "string" },
        "scheduled_at": { "type": ["string", "null"] },
        "scheduled_local_date": { "type": "string" },
        "timezone": { "type": "string" },
        "time_precision": { "enum": ["date_only", "time_confirmed", "time_estimated"] },
        "status": { "type": "string" },
        "expectation_type": { "type": "string" },
        "expectation_value": { "type": ["string", "null"] },
        "actual_value": { "type": ["string", "null"] },
        "previous_value": { "type": ["string", "null"] },
        "surprise": { "type": ["string", "null"] },
        "source": { "type": "string" },
        "source_url": { "type": "string" },
        "freshness": { "enum": ["fresh", "watch", "stale", "unsupported"] }
      },
      "additionalProperties": false
    },
    "metricTile": {
      "type": "object",
      "required": ["key", "label", "value", "source", "freshness", "delay_label", "updated_at"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "value": { "type": "string" },
        "unit": { "type": "string" },
        "source": { "type": "string" },
        "source_url": { "type": "string" },
        "freshness": { "enum": ["fresh", "watch", "stale", "unsupported"] },
        "delay_label": { "type": "string" },
        "updated_at": { "type": "string" },
        "coverage_status": { "enum": ["active", "coverage_gap"] },
        "refresh_seconds": { "type": "integer", "minimum": 60 },
        "refresh_delta": { "type": "number" },
        "refresh_delta_percent": { "type": "number" },
        "next_event": {
          "type": "object",
          "required": ["title", "date", "timezone", "source"],
          "properties": {
            "title": { "type": "string" },
            "date": { "type": "string" },
            "timezone": { "type": "string" },
            "source": { "type": "string" }
          },
          "additionalProperties": false
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "value"],
            "properties": {
              "date": { "type": "string" },
              "value": { "type": "number" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "alternativeSignalItem": {
      "type": "object",
      "required": ["key", "label", "value", "detail", "source", "freshness", "severity", "updated_at"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "value": { "type": "string" },
        "detail": { "type": "string" },
        "source": { "type": "string" },
        "source_url": { "type": "string" },
        "freshness": { "enum": ["fresh", "watch", "stale", "unsupported"] },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "updated_at": { "type": "string" },
        "symbols": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dataset": { "type": "string" },
        "as_of_date": { "type": "string" },
        "provider_observation_key": { "type": "string" }
      },
      "additionalProperties": false
    },
    "alternativeSignalLane": {
      "type": "object",
      "required": ["key", "title", "summary", "value", "cadence", "source", "freshness", "severity", "refresh_seconds", "items"],
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "value": { "type": "string" },
        "cadence": { "type": "string" },
        "source": { "type": "string" },
        "source_url": { "type": "string" },
        "freshness": { "enum": ["fresh", "watch", "stale", "unsupported"] },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "refresh_seconds": { "type": "integer", "minimum": 60 },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/alternativeSignalItem" }
        }
      },
      "additionalProperties": false
    },
    "newsMapPoint": {
      "type": "object",
      "required": [
        "point_id",
        "event_id",
        "event_ids",
        "title",
        "summary",
        "area_id",
        "area_key",
        "area_label",
        "relation",
        "latitude",
        "longitude",
        "severity",
        "urgency_score",
        "source_published_at",
        "observed_at",
        "source_count",
        "geo_confidence",
        "area_priority",
        "score_reason_codes"
      ],
      "properties": {
        "point_id": { "type": "string" },
        "event_id": { "type": "string" },
        "event_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "area_id": { "type": "string" },
        "area_key": { "type": "string" },
        "area_label": { "type": "string" },
        "relation": { "enum": ["event_location", "chokepoint", "affected_market", "source_region"] },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "urgency_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "source_published_at": { "type": "string" },
        "observed_at": { "type": "string" },
        "source_url": { "type": "string" },
        "source_count": { "type": "integer", "minimum": 0 },
        "geo_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "area_priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "score_reason_codes": { "type": "array", "items": { "type": "string" } },
        "item_kind": { "enum": ["source_discovery", "event_candidate", "reviewed_event", "filing_update", "official_update"] },
        "claim_level": { "enum": ["source_only", "clustered_candidate", "reviewed", "published"] },
        "evidence_match_status": { "enum": ["matched", "weak_match", "mismatch", "unverified"] },
        "review_state": { "enum": ["candidate", "approved", "reviewed", "published"] },
        "trust_tier": { "enum": ["T0_OFFICIAL", "T1_REGULATED_FILING", "T2_REPUTABLE_MEDIA", "T3_REVIEWED_PUBLIC_SOURCE", "T4_WEAK_SIGNAL", "T5_UNREVIEWED", "T6_BLOCKED"] }
      },
      "additionalProperties": false
    },
    "newsTickerRef": {
      "type": "object",
      "required": ["symbol", "name", "relationship", "confidence"],
      "properties": {
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "exchange": { "type": "string" },
        "relationship": {
          "enum": [
            "direct_subject",
            "affected_company",
            "competitor",
            "supplier",
            "customer",
            "mentioned_only"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "newsRegionRef": {
      "type": "object",
      "required": ["key", "name", "relation", "confidence"],
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "relation": {
          "enum": [
            "source_region",
            "event_region",
            "company_region",
            "affected_region",
            "market_region",
            "mentioned_region"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "newsTopicRef": {
      "type": "object",
      "required": ["key", "label", "confidence"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "breakingMarketEvent": {
      "type": "object",
      "required": [
        "event_id",
        "title",
        "summary",
        "source_published_at",
        "observed_at",
        "verified_at",
        "freshness_confidence",
        "urgency_score",
        "severity",
        "trust_tier",
        "discovery_only",
        "review_state",
        "citation_ids",
        "retention_class",
        "geo_points",
        "geo_confidence",
        "score_reason_codes",
        "dedupe_key",
        "label",
        "tickers",
        "regions",
        "topics",
        "source_count"
      ],
      "properties": {
        "event_id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "source_url": { "type": "string" },
        "source_published_at": { "type": "string" },
        "observed_at": { "type": "string" },
        "verified_at": { "type": "string" },
        "freshness_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "urgency_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "trust_tier": {
          "enum": [
            "T0_OFFICIAL",
            "T1_REGULATED_FILING",
            "T2_REPUTABLE_MEDIA",
            "T3_REVIEWED_PUBLIC_SOURCE",
            "T4_WEAK_SIGNAL",
            "T5_UNREVIEWED",
            "T6_BLOCKED"
          ]
        },
        "discovery_only": { "type": "boolean" },
        "review_state": { "enum": ["approved", "reviewed", "published"] },
        "citation_ids": { "type": "array", "items": { "type": "string" } },
        "retention_class": { "enum": ["metadata_only", "summary_only", "full_text_reviewed"] },
        "geo_points": { "type": "array", "items": { "$ref": "#/$defs/newsMapPoint" } },
        "geo_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "score_reason_codes": { "type": "array", "items": { "type": "string" } },
        "dedupe_key": { "type": "string" },
        "label": { "enum": ["breaking", "developing", "latest", "stale", "unmappable"] },
        "tickers": { "type": "array", "items": { "$ref": "#/$defs/newsTickerRef" } },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/newsRegionRef" } },
        "topics": { "type": "array", "items": { "$ref": "#/$defs/newsTopicRef" } },
        "source_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "breakingMarketMapData": {
      "type": "object",
      "required": [
        "events",
        "map_points",
        "watched_regions",
        "coverage_gaps",
        "regional_briefs",
        "shown_count",
        "total_count",
        "ranking_cutoff",
        "registry_version",
        "scoring_version",
        "thinning_version",
        "generated_at"
      ],
      "properties": {
        "events": { "type": "array", "items": { "$ref": "#/$defs/breakingMarketEvent" } },
        "map_points": { "type": "array", "items": { "$ref": "#/$defs/newsMapPoint" } },
        "watched_regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/watchedRegionCoverage" }
        },
        "coverage_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/watchedRegionCoverageGap" }
        },
        "regional_briefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/regionalBrief" }
        },
        "shown_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 0 },
        "ranking_cutoff": { "type": ["integer", "null"], "minimum": 0 },
        "registry_version": { "type": "integer", "minimum": 1 },
        "scoring_version": { "type": "string" },
        "thinning_version": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "watchedRegionCoverage": {
      "type": "object",
      "required": [
        "key",
        "type",
        "label",
        "iso3",
        "natural_earth_names",
        "groups",
        "priority",
        "gdp_rank",
        "gather_news",
        "render_on_map",
        "nav_visible",
        "coverage_status",
        "coverage_window_days",
        "event_count",
        "map_point_count",
        "newest_source_published_at",
        "quiet_reason"
      ],
      "properties": {
        "key": { "type": "string" },
        "type": { "enum": ["country", "region", "chokepoint"] },
        "label": { "type": "string" },
        "iso3": { "type": ["string", "null"] },
        "natural_earth_names": { "type": "array", "items": { "type": "string" } },
        "groups": { "type": "array", "items": { "type": "string" } },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "gdp_rank": { "type": ["integer", "null"], "minimum": 1 },
        "gather_news": { "type": "boolean" },
        "render_on_map": { "type": "boolean" },
        "nav_visible": { "type": "boolean" },
        "coverage_status": { "enum": ["active", "quiet", "coverage_gap"] },
        "coverage_window_days": { "type": "integer", "minimum": 1 },
        "event_count": { "type": "integer", "minimum": 0 },
        "map_point_count": { "type": "integer", "minimum": 0 },
        "newest_source_published_at": { "type": ["string", "null"] },
        "quiet_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "watchedRegionCoverageGap": {
      "type": "object",
      "required": [
        "region_key",
        "label",
        "reason",
        "coverage_window_days",
        "newest_source_published_at"
      ],
      "properties": {
        "region_key": { "type": "string" },
        "label": { "type": "string" },
        "reason": { "enum": ["no_recent_evidence", "not_geocoded", "not_reviewed", "source_disabled"] },
        "coverage_window_days": { "type": "integer", "minimum": 1 },
        "newest_source_published_at": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "regionalBrief": {
      "type": "object",
      "required": [
        "region_key",
        "label",
        "coverage_window_days",
        "generated_at",
        "summary",
        "event_count",
        "source_count",
        "newest_source_published_at",
        "evidence",
        "confidence"
      ],
      "properties": {
        "region_key": { "type": "string" },
        "label": { "type": "string" },
        "coverage_window_days": { "type": "integer", "minimum": 1 },
        "generated_at": { "type": "string" },
        "summary": { "type": "string" },
        "event_count": { "type": "integer", "minimum": 0 },
        "source_count": { "type": "integer", "minimum": 0 },
        "newest_source_published_at": { "type": ["string", "null"] },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event_id", "title", "source_published_at", "severity"],
            "properties": {
              "event_id": { "type": "string" },
              "title": { "type": "string" },
              "source_url": { "type": "string" },
              "source_published_at": { "type": "string" },
              "severity": { "enum": ["low", "medium", "high", "critical"] }
            },
            "additionalProperties": false
          }
        },
        "confidence": { "enum": ["metadata_only", "source_linked", "official_corroborated"] }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_version",
    "locale",
    "generated_at",
    "stale_after",
    "hard_expires_at",
    "object_type",
    "object_key",
    "content_hash",
    "source_policy_versions",
    "data",
    "warnings",
    "corrections"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "min_reader_version": { "type": "string" },
    "snapshot_version": { "type": "integer", "minimum": 1 },
    "locale": { "enum": ["en", "ko"] },
    "generated_at": { "type": "string" },
    "stale_after": { "type": "string" },
    "hard_expires_at": { "type": "string" },
    "object_type": { "type": "string" },
    "object_key": { "type": "string" },
    "content_hash": { "type": "string", "pattern": "^sha256:" },
    "source_policy_versions": { "type": "array", "items": { "$ref": "#/$defs/sourcePolicyVersion" } },
    "data": { "type": "object" },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
    "corrections": { "type": "array", "items": { "$ref": "#/$defs/correction" } }
  },
  "additionalProperties": false
}
