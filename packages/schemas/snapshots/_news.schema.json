{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stonks-radar.local/schemas/_news.schema.json",
  "$defs": {
    "trustTier": {
      "enum": [
        "T0_OFFICIAL",
        "T1_REGULATED_FILING",
        "T2_REPUTABLE_MEDIA",
        "T3_REVIEWED_PUBLIC_SOURCE",
        "T4_WEAK_SIGNAL",
        "T5_UNREVIEWED",
        "T6_BLOCKED"
      ]
    },
    "marketDirection": {
      "enum": ["bullish", "bearish", "mixed", "unclear"]
    },
    "regionRelation": {
      "enum": [
        "source_region",
        "event_region",
        "company_region",
        "affected_region",
        "market_region",
        "mentioned_region"
      ]
    },
    "facet": {
      "type": "object",
      "required": ["key", "label", "count"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "tickerRef": {
      "type": "object",
      "required": ["symbol", "name", "relationship", "confidence"],
      "properties": {
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "exchange": { "type": "string" },
        "relationship": {
          "enum": ["direct_subject", "affected_company", "competitor", "supplier", "customer", "mentioned_only"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "regionRef": {
      "type": "object",
      "required": ["key", "name", "relation", "confidence"],
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "relation": { "$ref": "#/$defs/regionRelation" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "topicRef": {
      "type": "object",
      "required": ["key", "label", "confidence"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "sourceRef": {
      "type": "object",
      "required": ["label", "url", "source_key", "policy_version", "title", "published_at", "trust_tier", "is_primary"],
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string", "pattern": "^https?://" },
        "source_key": { "type": "string" },
        "policy_version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "published_at": { "type": "string" },
        "trust_tier": { "$ref": "#/$defs/trustTier" },
        "is_primary": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "newsEventListItem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "event_type",
        "first_seen_at",
        "last_seen_at",
        "published_at",
        "freshness",
        "severity",
        "confidence",
        "breaking_score",
        "trust_score",
        "source_count",
        "tickers",
        "regions",
        "topics",
        "market_direction",
        "source_links"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,120}$" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "event_type": { "type": "string" },
        "first_seen_at": { "type": "string" },
        "last_seen_at": { "type": "string" },
        "published_at": { "type": "string" },
        "freshness": { "enum": ["fresh", "watch", "stale", "unsupported"] },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "breaking_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "trust_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "source_count": { "type": "integer", "minimum": 1 },
        "tickers": { "type": "array", "items": { "$ref": "#/$defs/tickerRef" } },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/regionRef" } },
        "topics": { "type": "array", "items": { "$ref": "#/$defs/topicRef" } },
        "market_direction": { "$ref": "#/$defs/marketDirection" },
        "source_links": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "newsEventDetail": {
      "allOf": [
        { "$ref": "#/$defs/newsEventListItem" },
        {
          "type": "object",
          "required": [
            "one_sentence_summary",
            "what_happened",
            "why_it_matters",
            "known_facts",
            "uncertainties",
            "conflicting_reports",
            "market_relevance",
            "related_events",
            "methodology",
            "disclaimer"
          ],
          "properties": {
            "one_sentence_summary": { "type": "string" },
            "what_happened": { "type": "array", "items": { "type": "string" } },
            "why_it_matters": { "type": "array", "items": { "type": "string" } },
            "known_facts": { "type": "array", "items": { "type": "string" } },
            "uncertainties": { "type": "array", "items": { "type": "string" } },
            "conflicting_reports": { "type": "array", "items": { "type": "string" } },
            "market_relevance": {
              "type": "object",
              "required": ["direction", "confidence", "reasoning"],
              "properties": {
                "direction": { "$ref": "#/$defs/marketDirection" },
                "confidence": { "enum": ["low", "medium", "high"] },
                "reasoning": { "type": "string" }
              },
              "additionalProperties": false
            },
            "related_events": {
              "type": "array",
              "items": { "$ref": "#/$defs/newsEventListItem" }
            },
            "methodology": { "type": "string" },
            "disclaimer": { "type": "string" }
          }
        }
      ]
    }
  }
}
