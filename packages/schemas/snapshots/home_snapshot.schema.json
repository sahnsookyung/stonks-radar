{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    { "$ref": "./_envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "object_type": { "const": "home" },
        "data": {
          "type": "object",
          "required": ["headline", "summary", "generated_label", "snapshot_health", "top_events", "breaking_market_events", "breaking_market_map", "macro_tiles", "alternative_signals", "sector_tiles", "calendar_preview", "scenario_baskets"],
          "properties": {
            "headline": { "type": "string" },
            "summary": { "type": "string" },
            "generated_label": { "type": "string" },
            "snapshot_health": { "type": "object" },
            "top_events": { "type": "array", "items": { "$ref": "./_envelope.schema.json#/$defs/event" } },
            "breaking_market_events": { "type": "array", "items": { "$ref": "./_envelope.schema.json#/$defs/breakingMarketEvent" } },
            "breaking_market_map": { "$ref": "./_envelope.schema.json#/$defs/breakingMarketMapData" },
            "macro_tiles": { "type": "array", "items": { "$ref": "./_envelope.schema.json#/$defs/metricTile" } },
            "alternative_signals": {
              "type": "array",
              "items": { "$ref": "./_envelope.schema.json#/$defs/alternativeSignalLane" }
            },
            "sector_tiles": { "type": "array" },
            "calendar_preview": { "type": "array", "items": { "$ref": "./_envelope.schema.json#/$defs/calendarItem" } },
            "scenario_baskets": { "type": "array" }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
