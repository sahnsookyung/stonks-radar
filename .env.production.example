APP_ENV=production
APP_BASE_URL=https://stonks.sookyungahn.com
PUBLIC_BASE_URL=https://stonks.sookyungahn.com
PUBLIC_HOSTNAME=stonks.sookyungahn.com
CADDY_EMAIL=admin@sookyungahn.com
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ko

POSTGRES_DB=frw
POSTGRES_USER=frw
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://frw:${POSTGRES_PASSWORD}@postgres:5432/frw
REDIS_URL=redis://valkey:6379/0

SESSION_SECRET=
PASSWORD_PEPPER=
TOTP_ISSUER=StonksRadar
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_TOTP_SECRET=

CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

SEC_USER_AGENT=StonksRadar contact@example.com
FRED_API_KEY=
BLS_API_KEY=
EIA_API_KEY=
FINRA_API_BASE_URL=https://api.finra.org
FINRA_OAUTH_TOKEN_URL=https://ews.fip.finra.org/fip/rest/ews/oauth2/access_token?grant_type=client_credentials
FINRA_API_CLIENT_ID=
FINRA_API_CLIENT_SECRET=
FINRA_API_TOKEN=
TRUMP_FILING_MONITORED_ENTITIES=DJT,Donald J. Trump Revocable Trust
OGE_DISCLOSURE_API_BASE_URL=https://extapps2.oge.gov/201/Presiden.nsf/API.xsp/v2/rest
OGE_DISCLOSURE_SEARCH_URL=https://www.oge.gov/web/oge.nsf/Officials%20Individual%20Disclosures%20Search%20Collection?OpenForm=
OGE_DISCLOSURE_PAGE_SIZE=1000
OGE_DISCLOSURE_MAX_INDEX_RECORDS=5000
TRUMP_DISCLOSURE_OGE_PDF_LIMIT=12
TRUMP_DISCLOSURE_SEC_FILING_LIMIT=50

GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434

PAID_USAGE_ALLOWED=false
PUBLIC_API_RATE_LIMIT_PER_MINUTE=60
ADMIN_API_RATE_LIMIT_PER_MINUTE=120
MARKET_DATA_CACHE_MAX_ENTRIES=512
SOURCE_FETCH_MAX_BYTES=5000000
SOURCE_FETCH_TIMEOUT_SECONDS=20

DEPLOY_MIN_A1_OCPUS=2
DEPLOY_MIN_A1_MEMORY_GB=12
DEPLOY_MIN_STORAGE_GB=50
