{
	email {$CADDY_EMAIL}
}

{$PUBLIC_HOSTNAME} {
	encode zstd gzip

	header {
		?Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api-elixir:8000}
	}

	handle /assets/* {
		root * /srv/web
		@existing_asset file {path}
		handle @existing_asset {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /map/* {
		root * /srv/web
		header Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		file_server
	}

	handle /public/latest/manifest.json {
		root * /srv/web
		header Cache-Control "no-cache, max-age=0, must-revalidate"
		file_server
	}

	@legacy_public_ops path_regexp ^/public/v[^/]+/(en|ko)/status\.json$
	handle @legacy_public_ops {
		respond 404
	}

	handle /public/* {
		root * /srv/web
		header Cache-Control "public, max-age=60, stale-while-revalidate=300"
		file_server
	}

	handle {
		root * /srv/web
		header Cache-Control "no-cache, max-age=0, must-revalidate, no-transform"
			header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://s3.tradingview.com; connect-src 'self'; frame-src https://www.tradingview-widget.com https://s.tradingview.com https://www.tradingview.com; worker-src 'self' blob:; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'"
		try_files {path} /index.html
		file_server
	}

}
